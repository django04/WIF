meta {
  name: 01 Create service user
  type: http
  seq: 1
}

post {
  url: https://{{apiHost}}/iam/v1/accounts/{{accountUuid}}/service-users
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{serviceUserName}}",
    "description": "OTel workload identity demo service user"
  }
}

vars:post-response {
  serviceUserUuid: res.body.uid
  serviceUserEmail: res.body.email
}

tests {
  function onResponse(request, response) {
    expect(response.status).to.be.within(200, 299);
    expect(response.body.uid).to.be.a('string').and.not.empty;
    expect(response.body.email).to.be.a('string').and.not.empty;
  }
}
